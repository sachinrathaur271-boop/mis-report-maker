# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# Database (MongoDB Atlas free tier works fine)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/mis_report_maker

# Auth (also doubles as the admin key + cron key for billing routes)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
